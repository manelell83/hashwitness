# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Testnet operator (https://portal.hedera.com/). DER key (starts with 3030...) or ECDSA hex.
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=

# Printed by `pnpm topics:create`
REGISTRY_TOPIC_ID=
ATTESTATION_TOPIC_ID=

# Extra mirror providers (M2). Free keys.
HGRAPH_API_KEY=
VALIDATIONCLOUD_API_KEY=
ARKHIA_API_KEY=
# Or any mirror REST endpoint (n = 1..9). {KEY} in the URL puts the key in the path; otherwise it is sent in
# MIRROR_n_HEADER (default x-api-key).
# MIRROR_1_URL=https://example-provider/hedera/testnet
# MIRROR_1_KEY=
# MIRROR_1_HEADER=x-api-key
# MIRROR_1_NAME=example

# AI forensic agent (M5), OpenAI-compatible chat completions
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# 300 for plain models; reasoning models (e.g. openai/gpt-oss-20b) need ~1000
LLM_MAX_TOKENS=1000
DEMO_REPLAY=0
