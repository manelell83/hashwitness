{
  "name": "hashwitness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web --noEmit",
    "topics:create": "tsx --env-file=.env scripts/create-topics.ts",
    "credential": "tsx --env-file=.env scripts/credential.ts",
    "status": "tsx --env-file=.env scripts/status.ts",
    "verify": "tsx --env-file=.env scripts/verify.ts",
    "attack": "tsx scripts/attack.ts",
    "fake-mirror": "tsx packages/fake-mirror/src/server.ts",
    "audit-log": "tsx --env-file=.env scripts/audit-log.ts",
    "dev": "pnpm --parallel --filter @hashwitness/fake-mirror --filter @hashwitness/api --filter @hashwitness/web run dev",
    "agent:record": "tsx --env-file=.env scripts/agent-record.ts",
    "sim": "tsx packages/sim/src/cli.ts",
    "demo:seed": "tsx --env-file=.env scripts/seed-demo.ts",
    "demo": "pnpm demo:seed && pnpm dev"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
